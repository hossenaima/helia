# Copy to .env and fill in. See README.md for what each one does.

# Supabase → Connect → URI. Two strings, told apart by port.
# Port 6543 (transaction pooler) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 5432 (session pooler) — used only to run migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Decides which calendar day an entry belongs to when the server runs in UTC.
APP_TIMEZONE="America/New_York"


# Set to "false" to close signup once everyone who needs an account has one.
ALLOW_SIGNUP="true"

# Google AI Studio key. Turns on calorie estimation and "What can I eat?".
# Without it the app still works and those buttons explain why they are off.
GEMINI_API_KEY=""
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=""

# Web push reminders. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret so only Vercel Cron can trigger reminder sending.
CRON_SECRET=""

# Announcements (scripts/announce.mjs). Gmail with an app password — not your
# account password. Generate one at myaccount.google.com/apppasswords with
# 2-Step Verification on. Only the announce script reads these; the app does not.
GMAIL_USER=
GMAIL_APP_PASSWORD=
