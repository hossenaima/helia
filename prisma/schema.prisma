// Healia — personal health tracker
// Docs: https://pris.ly/d/prisma-schema
//
// Days are stored as plain "YYYY-MM-DD" strings rather than DateTime. A morning
// weigh-in belongs to a calendar day in the user's local timezone; storing it as
// a UTC instant makes entries jump days across DST and travel.
//
// Every row of health data hangs off a User. Accounts are fully isolated: no
// query in the app reads a WeightEntry or Meal without filtering on userId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  /// Name as typed, used for display.
  name   String
  /// Lowercased `name`, used for lookup — so "Aima" and "aima" are one account.
  ///
  /// The *legacy* login key. Accounts made before usernames existed sign in
  /// with this; everyone else signs in with `username`. It stays queryable
  /// until every account has been through /setup, and can be retired then.
  handle String @unique

  /// The login identifier: lowercase, no spaces, chosen by the user. Null on
  /// accounts that predate it, which is exactly the set /setup exists to fix.
  username String? @unique

  /// scrypt hash of whatever secret this account currently signs in with.
  ///
  /// The column names say "pin" because that is all this held until usernames
  /// and passwords arrived, and renaming a column in this database means a
  /// drop, which takes production down until a manual deploy lands. The name
  /// is historical; the contents are a PIN before /setup and a password after.
  pinHash String
  pinSalt String

  /// Where announcements go. Null means no email on file — which is also how
  /// somebody opts out, because clearing the box and unsubscribing are the same
  /// intent and one column cannot disagree with itself the way a second flag
  /// beside it could.
  ///
  /// Not unique: two people sharing an address is odd but not wrong, and a
  /// unique index here would make one of them unable to save.
  email String?

  /// Whether to send the Monday digest. Separate from having an `email`, and
  /// **defaults false**, because wanting to hear about new features is not the
  /// same as wanting weekly statistics about your own body — defaulting it on
  /// would opt people into the second by way of the first. Same rule as the
  /// sharing flags: a new channel starts off.
  notifyDigest Boolean @default(false)

  /// Week key ("YYYY-MM-DD" of the Monday) of the last digest actually sent.
  /// The weekly sweep is at-least-once like the reminder one, so this is what
  /// stops a retry becoming a second email.
  lastDigestOn String?

  /// False only for accounts created before usernames and password rules. Such
  /// an account still signs in with its old PIN and is then sent to /setup,
  /// once, to choose both. Nothing else in the app reads this.
  setupComplete Boolean @default(true)

  /// Canonical storage is always pounds; `units` only controls display.
  goalWeightLbs  Float?
  startWeightLbs Float?
  heightInches   Float?
  units          String @default("lb") // "lb" | "kg"
  /// IANA zone, captured from the browser at sign-in. Decides when this
  /// person's day rolls over — a shared server default gets it wrong for
  /// anyone who is not in that zone.
  timezone       String @default("America/New_York")

  /// Daily targets, set by hand. Deliberately not derived from height and
  /// weight: population formulas can be off by hundreds of calories, and a
  /// wrong number here would quietly skew every budget in the app.
  calorieTarget  Int?
  proteinTargetG Int?
  fiberTargetG   Int?

  /// What notifications this account wants. Both default on: someone who has
  /// just granted permission has said yes to being notified, and making them
  /// then go and switch each kind on separately would be asking twice.
  notifyWeighIn Boolean @default(true)
  notifyFriends Boolean @default(true)
  /// Local hour (0–23) for the weigh-in reminder. `notifyWeighIn` decides
  /// whether it is sent at all; this only decides when.
  reminderHour  Int     @default(8)
  /// Whether accepted friends see your weigh-ins. One switch for all of them:
  /// the number is the same number whoever is looking, and defaults on because
  /// friends could already see it.
  ///
  /// Food is not here — it is per-friend, on `Friendship`. See the note there.
  shareWeight Boolean @default(true)

  /// Largest weight-loss milestone already congratulated, in whole pounds.
  /// Without it the same "10 lb down" would greet you every morning, which
  /// turns a moment into wallpaper.
  milestoneLbs Int @default(0)

  /// Day key of the last reminder actually sent. The schedulers that call the
  /// reminder route are all at-least-once, so this is what keeps a retry from
  /// becoming a second notification.
  lastRemindedOn String?

  weightEntries WeightEntry[]
  streakFreezes StreakFreeze[]
  meals         Meal[]
  dayLogs       DayLog[]
  sentRequests     Friendship[] @relation("requester")
  receivedRequests Friendship[] @relation("addressee")
  sentEncouragements     Encouragement[] @relation("encouragementFrom")
  receivedEncouragements Encouragement[] @relation("encouragementTo")
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeightEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM-DD" local day. One weigh-in per person per day.
  date      String
  weightLbs Float
  note      String?

  /// Where this reading came from, which is what makes a streak mean anything.
  ///
  /// - `live`     — logged on the day it is for
  /// - `health`   — came out of an Apple Health export
  /// - `backfill` — typed into the calendar for a day already past
  ///
  /// Only `backfill` is excluded from streaks: a number typed in afterwards is
  /// unverifiable, and being able to type one is how a streak gets faked.
  /// **Set on create only, never on update** — correcting today's figure
  /// tomorrow must not demote a day that really was logged live, and no
  /// correction can promote one that was not.
  source String @default("live")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// A stretch of days the user declared they would be away, so a missing
/// weigh-in does not break their streak.
///
/// Only ever the future: `startDate` must be today or later, which is what
/// keeps this from becoming a second way to repair a streak after the fact.
/// A frozen day holds a streak where it is; it never adds to it.
model StreakFreeze {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Inclusive "YYYY-MM-DD" bounds.
  startDate String
  endDate   String
  reason    String?

  createdAt DateTime @default(now())

  @@index([userId, startDate])
}

/// Per-day facts that are not a weigh-in and not a meal.
model DayLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM-DD" local day.
  date String
  /// Calories burned through activity, entered by hand. Subtracted from intake
  /// to give net calories.
  activeBurnKcal Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM-DD" local day.
  date String
  /// Free text, e.g. "Breakfast", "Post-run snack". There is no fixed set of
  /// meals — a day holds as many as the user logs.
  name String @default("Meal")
  /// What the user typed, verbatim, before any AI parsing.
  note String @default("")

  items MealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model MealItem {
  id       String  @id @default(cuid())
  mealId   String
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name     String
  /// Free text, e.g. "1 cup", "2 slices".
  quantity String?
  calories Int?
  proteinG Float?
  carbsG   Float?
  fatG     Float?
  fiberG   Float?
  sodiumMg Float?
  /// How the figure was arrived at, in the estimator's own words — the portion
  /// it assumed and what it counted. Shown so the number can be argued with
  /// rather than just accepted.
  basis    String?
  /// "manual" | "ai" — lets the UI flag estimates the user has not confirmed.
  source   String  @default("manual")
  /// "exact" for a packaged item with a label, "estimated" for anything whose
  /// oil, sauce or portion a kitchen decided. Inferred from the description
  /// rather than asked for; it drives the ± range shown.
  precision String @default("estimated")

  createdAt DateTime @default(now())

  @@index([mealId])
}

/// A mutual link between two accounts. Nothing is shared until the addressee
/// accepts — health data is not something you opt someone else into.
model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// "pending" | "accepted"
  status String @default("pending")

  /// Whether each side shares their food with the other, held per friendship
  /// rather than per account. Weight is one switch for everyone; food is not,
  /// because "who exactly sees what I ate" turns out to be a question people
  /// do want to answer per person — a close friend and someone you added last
  /// week are not the same audience for it.
  ///
  /// Two columns because one row covers both directions: A sharing with B says
  /// nothing about B sharing with A.
  ///
  /// Both cover the day's calorie total *and* the per-meal breakdown. They
  /// were separate flags once; a total you cannot attribute to anything is not
  /// much use, and the pair only made "you may see 1,900 kcal but not that it
  /// was pizza" expressible.
  ///
  /// Default false, like the account-wide flag they replaced: food was never
  /// visible, so turning it on for anyone would be deciding on the user's
  /// behalf.
  requesterSharesMeals Boolean @default(false)
  addresseeSharesMeals Boolean @default(false)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// A short note from one friend to another. Deliberately one-way and tiny —
/// this is a nudge, not a chat.
model Encouragement {
  id String @id @default(cuid())

  fromId String
  from   User   @relation("encouragementFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("encouragementTo", fields: [toId], references: [id], onDelete: Cascade)

  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([toId, createdAt])
}

/// One browser's push endpoint. A person may have several — phone, laptop —
/// and any of them can expire, so they are disposable by design.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}
